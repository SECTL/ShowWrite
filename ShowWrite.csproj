<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ProduceReferenceAssembly>True</ProduceReferenceAssembly>
		<GenerateDocumentationFile>False</GenerateDocumentationFile>
		<SelfContained>false</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<!-- 仅保留英文附属资源，避免生成 nl 等语言子目录 -->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<!-- Release 不生成调试符号，显著减小输出体积 -->
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>
	<PropertyGroup Label="Avalonia">
		<AvaloniaXamlIlDebuggerLaunch>False</AvaloniaXamlIlDebuggerLaunch>
		<ApplicationIcon>SW新圆角logo_256x256.ico</ApplicationIcon>
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>
	<ItemGroup>
	  <AvaloniaXaml Remove="CameraService\**" />
	  <AvaloniaXaml Remove="Plugins\**" />
	  <Compile Remove="CameraService\**" />
	  <Compile Remove="Plugins\**" />
	  <EmbeddedResource Remove="CameraService\**" />
	  <EmbeddedResource Remove="Plugins\**" />
	  <None Remove="CameraService\**" />
	  <None Remove="Plugins\**" />
	</ItemGroup>
	<ItemGroup>
	  <AvaloniaResource Include="SW新圆角logo_256x256.ico" />
	  <AvaloniaResource Include="boot.png" />
	  <AvaloniaResource Include="ammm.png" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="font\**\*.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</AvaloniaResource>
	</ItemGroup>

	<ItemGroup>
	  <Content Include="SW新圆角logo_256x256.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.0" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
		<PackageReference Include="Svg.Controls.Skia.Avalonia" Version="12.0.0.15" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="PanAndZoom" Version="12.0.0.1" />

		<PackageReference Include="PdfiumViewer" Version="2.13.0" />
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260222" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260222" />
		<PackageReference Include="PdfiumViewer.Native.x86_64.v8-xfa" Version="2018.4.8.256" />
		<PackageReference Include="SkiaSharp" Version="4.148.0" />

		<PackageReference Include="System.Drawing.Common" Version="10.0.3" />
		<PackageReference Include="System.Management" Version="10.0.3" />
		<PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
		<PackageReference Include="NAudio" Version="2.2.1" />
		<PackageReference Include="RapidOcrNet" Version="4.0.2" />

	</ItemGroup>

	<!-- 构建后清理随 NuGet 复制的原生 PDB（SkiaSharp/HarfBuzz 约 107MB）
	     Release：删除全部 PDB；Debug：只删除原生库 PDB，保留 ShowWrite.pdb 便于调试 -->
	<Target Name="TrimPdbFiles" AfterTargets="Build">
		<ItemGroup Condition="'$(Configuration)' == 'Release'">
			<_PdbToDelete Include="$(OutDir)**\*.pdb" />
		</ItemGroup>
		<ItemGroup Condition="'$(Configuration)' != 'Release'">
			<_PdbToDelete Include="$(OutDir)lib*.pdb" />
		</ItemGroup>
		<Delete Files="@(_PdbToDelete)" />
	</Target>
</Project>